# ============================================================
# nginx_agents.conf.template
#
# Optional: Add this block to your existing Nginx config to
# expose the agents app via a URL path.
#
# HOW TO USE:
#   1. Copy the relevant block below into your existing Nginx
#      server block (usually in /etc/nginx/sites-available/<site>)
#   2. Replace YOUR_DOMAIN.COM with your actual domain
#   3. Test: sudo nginx -t
#   4. Reload: sudo nginx -s reload
#
# IMPORTANT: Only do this AFTER the agents system is running.
# ============================================================

# ─────────────────────────────────────────────────────────────
# OPTION A: Add a /agents-api/ path to your existing domain
# (Minimal change — safest option)
# ─────────────────────────────────────────────────────────────

