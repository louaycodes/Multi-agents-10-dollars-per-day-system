# ─────────────────────────────────────────────────────────────
# OPTION B: Separate subdomain for agents (e.g. agents.mysite.com)
# Requires a DNS A record pointing agents.mysite.com to VPS IP.
# ─────────────────────────────────────────────────────────────
server {
    listen 80;
    server_name agents.YOUR_DOMAIN.COM;

    # Redirect HTTP → HTTPS (if using SSL)
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
        proxy_buffering off;
    }

    # Serve agent logs as plain text (optional, useful for monitoring)
    location /logs/ {
        alias /home/louay/agents-system/logs/;
        autoindex on;
        default_type text/plain;
        # Security: restrict to specific IPs if needed
        # allow YOUR_IP;
        # deny all;
    }
}

