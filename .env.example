# ==============================================================================
# .env.example — Copy to .env and fill in your real values
# NEVER commit .env to version control
# ==============================================================================

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agents_db
DB_USER=postgres
DB_PASSWORD=change_me_secure_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ──────────────────────────────────────────────
# LLM Configuration
# Primary: Ollama (local, free)  |  Fallback: OpenAI
# ──────────────────────────────────────────────
LLM_TYPE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=60

# OpenAI fallback (optional — leave blank if not available)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2048

# ──────────────────────────────────────────────
# NICHE 1: Product Reselling
# ──────────────────────────────────────────────
# AliExpress (scrape mode = no key needed)
ALIEXPRESS_SCRAPE_MODE=true
ALIEXPRESS_API_KEY=

# Facebook Marketplace (Graph API)
FACEBOOK_API_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_MARKETPLACE_ENABLED=false

# Shopee Seller (optional alternative)
SHOPEE_SELLER_ID=
SHOPEE_API_KEY=
SHOPEE_ENABLED=false

# Reselling budget buffer ($) — max capital for purchasing products
RESELLING_BUDGET=20.0
MIN_PROFIT_MARGIN=0.60

# ──────────────────────────────────────────────
# NICHE 2: Micro-Gigs & Tasks
# ──────────────────────────────────────────────
# Fiverr — API only (no Selenium, ToS compliant)
FIVERR_API_TOKEN=
FIVERR_ENABLED=false

# Amazon Mechanical Turk
MTURK_ACCESS_KEY=
MTURK_SECRET_KEY=
MTURK_REGION=us-east-1
# IMPORTANT: Keep true until you verify your account is production-ready
MTURK_SANDBOX=true

# Clickworker (optional)
CLICKWORKER_API_KEY=
CLICKWORKER_ENABLED=false

# ──────────────────────────────────────────────
# NICHE 3: Affiliate & Content
# ──────────────────────────────────────────────
# Reddit API (free — register app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=MultiAgentSystem/1.0

# Amazon Associates affiliate
AMAZON_AFFILIATE_ID=
AMAZON_AFFILIATE_TAG=

# Udemy affiliate
UDEMY_AFFILIATE_KEY=

# Estimated payout per affiliate click (used in ROI scoring)
AFFILIATE_PAYOUT_PER_CLICK=0.25

# ──────────────────────────────────────────────
# System Configuration
# ──────────────────────────────────────────────
TIMEZONE=UTC
LOG_LEVEL=INFO
DAILY_TARGET=10.0

# Agent schedule (24h format, UTC)
MANAGER_HOUR=6
MANAGER_MINUTE=0
HUNTER_HOUR=6
HUNTER_MINUTE=30
EXECUTOR_HOUR=7
EXECUTOR_MINUTE=0
TRACKER_INTERVAL_MINUTES=15
OPTIMIZER_CHECK_HOUR=14
OPTIMIZER_CHECK_MINUTE=0
DAILY_CLOSE_HOUR=20
DAILY_CLOSE_MINUTE=0

# Max concurrent scraping threads
SCRAPER_MAX_THREADS=4
SCRAPER_REQUEST_DELAY=2.0
SCRAPER_TIMEOUT=30

# Max opportunities passed from Hunter to Executor
MAX_OPPORTUNITIES=8
